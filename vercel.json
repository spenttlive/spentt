{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "spentt.live" }],
      "destination": "https://www.spentt.live/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap.xml|robots.txt|blog/|tools/|privacy.html|terms.html|og-image.png|manifest.json|icon|googlea|favicon).*)",
      "destination": "/index.html"
    }
  ]
}